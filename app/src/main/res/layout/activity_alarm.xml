<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_ringing_title"
        android:textSize="18sp"
        android:textColor="#F59E0B"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="--:--"
        android:textSize="56sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alarm_ringing_subtitle"
        android:textSize="14sp"
        android:textColor="#94A3B8" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:text="@string/dismiss"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#F59E0B"
        android:textColor="#0F172A" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/snooze_5m"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#1E293B"
        android:textColor="#E2E8F0" />

</LinearLayout>
